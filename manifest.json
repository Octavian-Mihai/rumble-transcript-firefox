{
  "manifest_version": 3,
  "name": "Rumble Transcript Copier",
  "version": "1.0.0",
  "description": "Copy the current Rumble video’s captions to the clipboard as timestamped text.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{4c1f7a52-8d0e-4b6e-9a53-2f6b1d7e9c11}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "host_permissions": ["*://rumble.com/*", "*://*.rumble.com/*"],
  "action": {
    "default_title": "Copy Rumble transcript",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["*://rumble.com/*", "*://*.rumble.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
